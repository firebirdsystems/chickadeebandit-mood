{
  "id": "mood",
  "contexts": ["household", "shared_space"],
  "name": "Mood Journal",
  "version": "1.2.0",
  "description": "Daily private mood and energy check-ins with gentle prompts and trend views over time. Entries stay private by default; opt in to share trends with a parent or partner.",
  "entrypoint": "index.html",
  "runtime": "static",
  "icon": "🌤️",
  "category": "general",
  "tags": ["wellness", "mood", "journal", "mental-health", "reflection"],
  "storage": "db",
  "preload": {
    "entries": { "sql": "SELECT id, member_id, entry_date, mood, energy, symptoms, note, prompt, created_at, updated_at FROM app_mood__entries WHERE member_id = ? ORDER BY entry_date DESC LIMIT 180", "params": [":me"] },
    "outgoing_shares": { "sql": "SELECT id, owner_id, viewer_id FROM app_mood__shares WHERE owner_id = ?", "params": [":me"] },
    "incoming_shares": { "sql": "SELECT DISTINCT owner_id FROM app_mood__trend_shares WHERE viewer_id = ?", "params": [":me"] },
    "trend_viewers": { "sql": "SELECT DISTINCT viewer_id FROM app_mood__trend_shares WHERE owner_id = ?", "params": [":me"] }
  },
  "db_plaintext_columns": ["entry_date", "mood", "energy"],
  "row_policies": {
    "entries": {
      "kind": "owner_only",
      "member_column": "member_id",
      "adults_bypass": false,
      "retain_days": { "default": 365, "timestamp_column": "entry_date", "override_key": "mood_history" }
    },
    "shares": { "kind": "owner_only", "member_column": "owner_id", "adults_bypass": false },
    "trend_shares": {
      "kind": "party_scoped",
      "member_columns": ["owner_id", "viewer_id"],
      "self_column": "owner_id",
      "retain_days": { "default": 365, "timestamp_column": "entry_date", "override_key": "mood_history" }
    }
  },
  "member_references": {
    "entries": { "column": "member_id", "on_removed": "delete" },
    "shares": [
      { "column": "owner_id", "on_removed": "delete" },
      { "column": "viewer_id", "on_removed": "delete" }
    ],
    "trend_shares": [
      { "column": "owner_id", "on_removed": "delete" },
      { "column": "viewer_id", "on_removed": "delete" }
    ]
  },
  "data_access": {
    "reads": ["family.members"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "nav": { "label": "Mood" },
  "resource_limits": {
    "max_db_bytes": 52428800
  }
}
